import jh_supply  # noqa: E402
import jh_config  # noqa: E402
import jh_calibrate  # noqa: E402
import jh_dedup  # noqa: E402


class Spinner:
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, enabled: bool):
        self.enabled = enabled
        self.i = 0
        self.last = 0.0

    def update(self, text: str) -> None:
        if not self.enabled:
            return
        now = time.time()
        if now - self.last < 0.07:
            return
        self.last = now
        frame = self.FRAMES[self.i % len(self.FRAMES)]
        self.i += 1
        sys.stderr.write("\r\x1b[2K  \x1b[38;5;51m%s\x1b[0m %s" % (frame, text))
        sys.stderr.flush()

    def done(self) -> None:
        if self.enabled:
            sys.stderr.write("\r\x1b[2K")
            sys.stderr.flush()


def _manifest_files(root: str, max_depth: int = 4) -> List[Tuple[str, str]]:
    names = {
        "package.json", "package-lock.json", "npm-shrinkwrap.json", "yarn.lock",
        "pnpm-lock.yaml", "bun.lockb", "requirements.txt", "pyproject.toml",
        "pipfile.lock", "poetry.lock", "cargo.lock", "go.mod", "pom.xml",
        "build.gradle", "build.gradle.kts", "gemfile.lock", "composer.lock",
        "pubspec.lock",
    }
    out: List[Tuple[str, str]] = []
    base = os.path.abspath(root)
    for dirpath, dirnames, filenames in os.walk(base):
        rel_dir = os.path.relpath(dirpath, base)
        depth = 0 if rel_dir == "." else rel_dir.count(os.sep) + 1
        if depth > max_depth:
            dirnames[:] = []
            continue
        dirnames[:] = [d for d in dirnames if d not in {
            "node_modules", ".git", "vendor", "dist", "build", "target", ".venv",
            "venv", "__pycache__", ".tox", ".gradle", "Pods", "DerivedData",
        } and not d.startswith(".")]
        for fn in filenames:
            low = fn.lower()
            if low in names or low.endswith((".csproj", ".fsproj", ".vbproj")):
                path = os.path.join(dirpath, fn)
                rel = os.path.relpath(path, base).replace(os.sep, "/")
                out.append((path, rel))
    return out


def _probe_root(paths: Sequence[str]) -> str:
    """Cheap, deterministic preview of the root discover_files() will land
    on, needed only so config discovery can happen before the real scan."""
    from pathlib import Path as _Path
    roots = [_Path(p).expanduser().resolve() for p in (paths or ["."])]
    if len(roots) == 1 and roots[0].is_dir():
        return str(roots[0])
    return str(_Path.cwd().resolve())


def run_scan(args: argparse.Namespace, spinner: Optional[Spinner] = None) -> Tuple[str, ScanResult, Dict[str, object]]:
    t0 = time.time()
    cfg = jh_config.load_config_for_root(
        _probe_root(args.paths),
        explicit_path=getattr(args, "config", None),
        disabled=getattr(args, "no_config", False),
    )
    jh_config.emit_warnings(cfg)
    excludes = list(args.exclude or ()) + cfg.ignore_globs
    root, files = discover_files(
        args.paths,
        excludes=excludes,
        max_files=args.max_files,
        max_bytes=args.max_file_bytes,
    )
    if spinner:
        spinner.update("reading %d files…" % len(files))
    sources = []
    skipped = 0
    for idx, path in enumerate(files, 1):
        sf = load_source(path, root)
        if sf is None:
            skipped += 1
        else:
            sources.append(sf)
        if spinner and idx % 17 == 0:
            spinner.update("reading %d/%d  %s" % (idx, len(files), os.path.basename(str(path))))
    if spinner:
        spinner.update("scanning %d files with %d rules…" % (len(sources), len(RULES)))
    opts = ScanOptions(
        min_severity=args.min_severity,
        categories=set(args.category) if args.category else None,
        rule_ids=set(args.rule) if args.rule else None,
        max_per_file_rule=args.max_per_file_rule,
        max_per_rule=args.max_per_rule,
    )
    result = scan_sources(sources, opts)
    if cfg.source:
        result.findings = jh_config.apply_to_findings(cfg, result.findings)
        result.findings.sort(key=lambda f: f.sort_key())
    meta: Dict[str, object] = {
        "root": str(root),
        "elapsed": time.time() - t0,
        "skipped": skipped,
        "cve": bool(args.cve),
    }
    if cfg.source:
        meta["config"] = cfg.source
    meta["cross_file_duplicates"] = [c.to_dict() for c in jh_dedup.find_cross_file_duplicates(result.findings)]
    if getattr(args, "calibrate", False):
        ledger = jh_calibrate.load_ledger(str(root))
        notes = jh_calibrate.apply_calibration(result.findings, ledger, SEVERITIES)
        result.findings.sort(key=lambda f: f.sort_key())
        jh_calibrate.update_ledger(ledger, result.fired_by_rule, result.suppressed_by_rule)
        jh_calibrate.save_ledger(str(root), ledger)
        meta["calibration"] = {
            "ledger": jh_calibrate.ledger_path(str(root)),
            "downgrades": [n.to_dict() for n in notes],
        }
    if args.cve:
        manifests = _manifest_files(str(root))
        deps = jh_cve.collect_dependencies(manifests)
        if not deps:
            meta["cve_warnings"] = ["no pinned dependencies found in known manifests"]
        else:
            cve = jh_cve.query_osv(deps)
            result.findings.extend(cve.findings)
            result.findings.sort(key=lambda f: f.sort_key())
            meta["cve_packages"] = cve.packages
            meta["cve_queried"] = cve.queried
            if cve.warnings:
                meta["cve_warnings"] = cve.warnings
    since = getattr(args, "since", None)
    if since:
        changed, warning = jh_score.changed_lines(str(root), since)
        if changed is None:
            meta["new_code"] = {"since": since, "warning": warning}
        else:
            _, new_meta = jh_score.compute_new_code(result.findings, changed, since)
            meta["new_code"] = new_meta
    meta["elapsed"] = time.time() - t0
    if spinner:
        spinner.done()
    return str(root), result, meta


def _scan_json(root: str, result: ScanResult, meta: Dict[str, object]) -> str:
    counts: Dict[str, int] = {}
    for f in result.findings:
        counts[f.severity] = counts.get(f.severity, 0) + 1
    score = jh_score.compute(result.findings, result.loc)
    if meta.get("new_code"):
        score.new_code = meta["new_code"]
    data = {
        "tool": TOOL,
        "version": VERSION,
        "command": "scan",
        "root": root,
        "summary": {
            "files": result.files,
            "loc": result.loc,
            "findings": len(result.findings),
            "counts": counts,
            "jank_score": score.score,
            "jank": score.to_dict(),
            "elapsed_seconds": round(float(meta.get("elapsed", 0)), 3),
            "cve": meta.get("cve", False),
            "cve_packages": meta.get("cve_packages", 0),
        },
        "warnings": meta.get("cve_warnings", []),
        "config": meta.get("config"),
        "cross_file_duplicates": meta.get("cross_file_duplicates", []),
        "calibration": meta.get("calibration"),
        "findings": [asdict(f) for f in result.findings],
    }
    return json.dumps(data, indent=2, ensure_ascii=False)


def _sarif(result: ScanResult) -> str:
    levels = {"blocker": "error", "critical": "error", "major": "warning", "minor": "note", "info": "note"}
    rules = {}
    results = []
    for f in result.findings:
        rule = rule_by_id(f.rule)
        if f.rule not in rules:
            rules[f.rule] = {
                "id": f.rule,
                "name": f.title,
                "shortDescription": {"text": f.title},
                "fullDescription": {"text": rule.message if rule else f.message},
                "help": {"text": f.fix or (rule.fix if rule else "")},
                "properties": {
                    "category": f.category,
                    "severity": f.severity,
                    "confidence": f.confidence,
                    "tags": list(f.tags),
                },
            }
        results.append({
            "ruleId": f.rule,
            "level": levels.get(f.severity, "note"),
            "message": {"text": f.message or f.title},
            "locations": [{
                "physicalLocation": {
                    "artifactLocation": {"uri": urllib.parse.quote(f.path.replace(os.sep, "/"), safe="/")},
                    "region": {
                        "startLine": max(1, f.line),
                        "startColumn": max(1, f.column),
                        **({"endLine": f.end_line} if f.end_line else {}),
                    },
                }
            }],
            "partialFingerprints": {"jankhunt": "%s:%s:%d" % (f.rule, f.path, f.line)},
            "properties": {
                "severity": f.severity,
                "confidence": f.confidence,
                "evidence": f.evidence,
                "fix": f.fix,
                "tags": list(f.tags),
            },
        })
    sarif = {
        "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
        "version": "2.1.0",
        "runs": [{
            "tool": {"driver": {
                "name": "jankhunt",
                "version": VERSION,
                "rules": list(rules.values()),
            }},
            "results": results,
        }],
    }
    return json.dumps(sarif, indent=2, ensure_ascii=False)


def cmd_scan(args: argparse.Namespace) -> int:
    formats = sum(1 for enabled in (args.md, args.json, args.sarif, args.html) if enabled)
    if formats > 1:
        print("jankhunt: choose one output format: --md, --json, --sarif, or --html",
              file=sys.stderr)
        return 2
    tty = sys.stdout.isatty() and not args.md and not args.json and not args.sarif and not args.html
    spinner = Spinner(tty and not args.quiet and not args.no_progress)
    root, result, meta = run_scan(args, spinner)
    if args.json:
        print(_scan_json(root, result, meta))
    elif args.sarif:
        print(_sarif(result))
    elif args.html:
        print(jh_html.render_scan(result, meta, args.max_findings))
    else:
        no_color = args.no_color or not tty
        print(jh_render.render_scan(result, meta, tty, no_color, args.max_findings))
    if args.fail_on:
        for f in result.findings:
            if sev_at_least(f.severity, args.fail_on):
                return 1
    return 0


def cmd_review(args: argparse.Namespace) -> int:
    formats = sum(1 for enabled in (args.md, args.json, args.sarif, args.brief) if enabled)
    if formats > 1:
        print("jankhunt: choose one output format: --md, --json, --sarif, or --brief",
              file=sys.stderr)
        return 2
    try:
        data = jh_review.run_review(args)
    except jh_review.ReviewError as exc:
        print("jankhunt: %s" % exc, file=sys.stderr)
        return 2
    if getattr(args, "save_baseline", ""):
        try:
            with open(args.save_baseline, "w", encoding="utf-8") as fh:
                json.dump(data, fh, indent=2, ensure_ascii=False)
                fh.write("\n")
            if not args.json:
                print("review baseline written: %s" % args.save_baseline, file=sys.stderr)
        except OSError as exc:
            print("jankhunt: cannot write baseline: %s" % exc, file=sys.stderr)
            return 2
    review = data["review"]
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    elif args.sarif:
        print(jh_review.sarif(review))
    elif args.brief:
        print(jh_review.brief(review))
    elif args.md:
        print(jh_review.markdown(review, args.max_findings))
    else:
        tty = sys.stdout.isatty()
        if tty:
            print(jh_review.tty(review, args.max_findings, args.no_color))
        else:
            print(jh_review.markdown(review, args.max_findings))
    return 1 if review["gate"]["result"] == "fail" else 0


def cmd_supply_chain(args: argparse.Namespace) -> int:
    formats = sum(1 for enabled in (args.md, args.json) if enabled)
    if formats > 1:
        print("jankhunt: choose one output format: --md or --json", file=sys.stderr)
        return 2
    root = os.path.abspath(args.paths[0] if args.paths else ".")
    if os.path.isfile(root):
        root = os.path.dirname(root)
    requirements = {
        "sbom": bool(args.require_sbom),
        "attestation": bool(args.require_attestation),
        "verified_attestation": bool(args.require_verified_attestation),
    }
    report = jh_supply.inspect(
        root,
        sbom_paths=args.sbom or (),
        attestation_paths=args.attestation or (),
        jfrog_paths=args.jfrog_evidence or (),
        requirements=requirements,
        discover=not args.no_discover,
    )
    payload = {
        "tool": TOOL,
        "version": VERSION,
        "command": "supply-chain",
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        **report,
    }
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    elif args.md or not sys.stdout.isatty():
        print(jh_supply.markdown(report))
    else:
        color = jh_render.Colors(not args.no_color)
        print(color.bold("SUPPLY-CHAIN EVIDENCE") + "  " + color.grey(root))
        print("  " + jh_supply.summary_line(report))
        print("")
        print(jh_supply.markdown(report, heading="## Evidence"))
    return 1 if report["gate"]["result"] == "fail" else 0


def cmd_score(args: argparse.Namespace) -> int:
    tty = sys.stdout.isatty() and not args.json and not args.md
    spinner = Spinner(tty and not args.quiet and not args.no_progress)
    root, result, meta = run_scan(args, spinner)
    report = jh_score.compute(result.findings, result.loc)
    if meta.get("new_code"):
        report.new_code = meta["new_code"]
    if args.json:
        data = {
            "tool": TOOL,
            "version": VERSION,
            "command": "score",
            "root": root,
            "files": result.files,
            "loc": result.loc,
            "jank": report.to_dict(),
            "warnings": meta.get("cve_warnings", []),
            "config": meta.get("config"),
            "cross_file_duplicates": meta.get("cross_file_duplicates", []),
            "calibration": meta.get("calibration"),
        }
        print(json.dumps(data, indent=2, ensure_ascii=False))
    elif tty and not args.no_color:
        color = jh_render.Colors(True)
        width = jh_render._width()
        header = jh_render.banner(
            "jank score // weakest link first",
            "%s  ·  %s files  ·  %s LOC" % (root, f"{result.files:,}", f"{result.loc:,}"),
            color, width,
        )
        print("\n".join(header + [""] + jh_score.scorecard_tty(report, color, width)))
    else:
        print(jh_score.scorecard_markdown(report))
    if args.fail_policy and report.policy == "fail":
        return 1
    return 0


def cmd_hunt(args: argparse.Namespace) -> int:
    tty = sys.stdout.isatty() and not args.md and not args.json
    spinner = None if args.no_scan else Spinner(tty and not args.quiet and not args.no_progress)
    if args.no_scan:
        root = os.path.abspath(args.paths[0] if args.paths else ".")
        result = ScanResult()
        meta: Dict[str, object] = {"elapsed": 0.0, "cve": False}
    else:
        root, result, meta = run_scan(args, spinner)
    plan = jh_hunt.build_plan(
        root, result, meta,
        focus=args.focus,
        panel=args.panel,
        rounds=args.rounds,
        max_agents=args.max_agents,
        lead_limit=args.leads,
        include_prompts=True,
        scope=args.paths or [root],
        exclusions=args.exclude or (),
    )
    if args.json:
        content = json.dumps(plan, indent=2, ensure_ascii=False)
        print(content)
    elif tty and not args.no_color:
        print(jh_hunt.hunt_tty(plan))
    else:
        print(jh_hunt.hunt_markdown(plan, include_prompts=args.prompts))
    if args.out:
        if args.json or (not args.md and args.out.endswith(".json")):
            payload = json.dumps(plan, indent=2, ensure_ascii=False)
        else:
            payload = jh_hunt.hunt_markdown(plan, include_prompts=args.prompts)
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write(payload + "\n")
        print("hunt brief written: %s" % args.out, file=sys.stderr)
        print("  focus: %s · panelists: %d · leads: %d · rounds: %d"
              % (plan["focus"], len(plan["roles"]), len(plan["leads"]), len(plan["rounds"])),
              file=sys.stderr)
    return 0


def cmd_merge(args: argparse.Namespace) -> int:
    paths = list(args.paths)
    if not paths:
        if not sys.stdin.isatty():
            paths = ["-"]
        else:
            print("jankhunt: give at least one panel JSON file (or pipe via stdin)", file=sys.stderr)
            return 2
    try:
        reports = jh_hunt.load_reports(paths)
    except (OSError, ValueError) as exc:
        print("jankhunt: %s" % exc, file=sys.stderr)
        return 2
    merged = jh_hunt.merge_reports(reports)
    if args.json:
        print(json.dumps(merged, indent=2, ensure_ascii=False))
    else:
        tty = sys.stdout.isatty() and not args.md
        if tty and not args.no_color:
            print(jh_hunt.merge_tty(merged))
        else:
            print(jh_hunt.merge_markdown(merged))
    if args.fail_on:
        for f in merged["findings"]:
            if f["status"] == "confirmed" and sev_at_least(f["severity"], args.fail_on):
                return 1
    return 0


def cmd_triage(args: argparse.Namespace) -> int:
    paths = list(args.paths)
    if not paths:
        if not sys.stdin.isatty():
            paths = ["-"]
        else:
            print("jankhunt: give at least one log file (or pipe via stdin)", file=sys.stderr)
            return 2
    result = jh_triage.triage_paths(paths, grep=args.grep)
    if args.json:
        print(jh_triage.triage_json(result, args.top))
    else:
        tty = sys.stdout.isatty() and not args.md
        print(jh_render.render_triage(result, tty, args.no_color or not tty, args.top))
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    result = jh_doctor.doctor(args.path or ".", deep=args.system)
    if args.json:
        print(jh_doctor.doctor_json(result))
    else:
        tty = sys.stdout.isatty() and not args.md
        print(jh_render.render_doctor(result, tty, args.no_color or not tty))
    return 0


def cmd_rules(args: argparse.Namespace) -> int:
    rows = [r for r in RULES if (not args.category or r.category in args.category)
            and sev_at_least(r.severity, args.min_severity)]
    if args.json:
        print(json.dumps([{
            "id": r.id, "title": r.title, "severity": r.severity, "category": r.category,
            "confidence": r.confidence, "message": r.message, "fix": r.fix,
            "tags": list(r.tags), "dynamic": r.id == "JH901",
        } for r in rows], indent=2, ensure_ascii=False))
        return 0
    print("# JankHunt42 rule catalog\n")
    print("| Rule | Severity | Category | Confidence | Title |")
    print("|---|---|---|---|---|")
    for r in rows:
        print("| `%s` | %s | %s | %s | %s |" % (r.id, r.severity, r.category, r.confidence, r.title))
    print("\n%d rules shown. `JH901` is populated by `scan --cve` (OSV.dev)." % len(rows))
    return 0


def _report_markdown(root: str, scan: ScanResult, meta: Dict[str, object],
                     doctor: jh_doctor.DoctorResult,
                     logs: Optional[jh_triage.TriageResult]) -> str:
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    counts: Dict[str, int] = {}
    for f in scan.findings:
        counts[f.severity] = counts.get(f.severity, 0) + 1
    score = jh_score.compute(scan.findings, scan.loc)
    if meta.get("new_code"):
        score.new_code = meta["new_code"]
    out: List[str] = []
    out.append("# JankHunt42 report")
    out.append("")
    out.append("**Root:** `%s` · **Generated:** %s · **Files:** %d · **LOC:** %d"
               % (root, now, scan.files, scan.loc))
    out.append("")
    out.append("## 1. Executive summary")
    out.append("")
    out.append(jh_score.scorecard_markdown(score, heading="### Jank score"))
    out.append("")
    out.append("**Findings:** %d — %s"
               % (len(scan.findings),
                  ", ".join("%s %d" % (s, counts[s]) for s in SEVERITIES if counts.get(s)) or "none"))
    top = jh_render._top_rules(scan.findings, 8)
    if top:
        out.append("")
        out.append("| Rule | Title | Count |")
        out.append("|---|---|---:|")
        for rid, title, count in top:
            out.append("| `%s` | %s | %d |" % (rid, title, count))
    if meta.get("cve_warnings"):
        out.append("")
        for warning in meta["cve_warnings"]:
            out.append("> CVE lookup: %s" % warning)
    out.append("")
    out.append("## 2. Environment")
    out.append("")
    from jh_doctor import doctor_markdown
    env = doctor_markdown(doctor).split("\n", 1)
    out.append(env[1] if len(env) > 1 else "")
    out.append("")
    out.append("## 3. Static findings")
    out.append("")
    body = jh_render.scan_markdown(scan, meta, max_findings=150).split("\n", 1)
    out.append(body[1] if len(body) > 1 else body[0])
    if logs is not None:
        out.append("")
        out.append("## 4. Log triage")
        out.append("")
        from jh_triage import triage_markdown
        log_md = triage_markdown(logs, top=20).split("\n", 1)
        out.append(log_md[1] if len(log_md) > 1 else log_md[0])
    out.append("")
    out.append("## 5. Investigation worksheet")
    out.append("")
    out.append("| Field | Value |")
    out.append("|---|---|")
    out.append("| Symptom (expected vs actual) | _fill_ |")
    out.append("| Exact repro command | _fill_ |")
    out.append("| Frequency / first seen | _fill_ |")
    out.append("| Last known good | _fill_ |")
    out.append("| Suspect change | _fill_ |")
    out.append("| Hypothesis H1 | _fill_ |")
    out.append("| Cheapest discriminating test | _fill_ |")
    out.append("| Root cause (proven) | _fill_ |")
    out.append("| Fix + regression test | _fill_ |")
    out.append("")
    out.append("## 6. Next moves")
    out.append("")
    out.append("1. Reproduce the failure and capture exit code + full stack trace.")
    out.append("2. Confirm the top severity findings in context; do not fix regex hits blindly.")
    out.append("3. Run the project's native compiler/tests/linter; compare against the last known good commit.")
    out.append("4. If the bug is intermittent, add timestamps/correlation IDs and measure frequency before changing code.")
    out.append("5. Record the causal chain and the verification command in the final report.")
    return "\n".join(out)


def cmd_report(args: argparse.Namespace) -> int:
    spinner = Spinner(sys.stdout.isatty() and not args.quiet and not args.no_progress)
    root, scan, meta = run_scan(args, spinner)
    spinner.update("checking the environment…")
    doc = jh_doctor.doctor(root, deep=args.system)
    logs = None
    if args.logs:
        logs = jh_triage.triage_paths(args.logs)
    report = _report_markdown(root, scan, meta, doc, logs)
    if args.out:
        spinner.done()
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write(report + "\n")
        counts: Dict[str, int] = {}
        for f in scan.findings:
            counts[f.severity] = counts.get(f.severity, 0) + 1
        score = jh_score.compute(scan.findings, scan.loc)
        print("report written: %s" % args.out)
        print("  files: %d · findings: %d · jank: %d/100 (%s · %s) · policy %s"
              % (scan.files, len(scan.findings), score.score, score.grade,
                 score.label, score.policy))
        if counts:
            print("  " + " · ".join("%s %d" % (s, counts[s]) for s in SEVERITIES if counts.get(s)))
    else:
        print(report)
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="jankhunt",
        description="Find the jank before it finds production. Code, CI, Kubernetes, secrets, CVEs, logs.",
    )
    p.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    sub = p.add_subparsers(dest="command", required=True)

    def add_common_scan_inputs(sp, cve_help):
        sp.add_argument("--no-color", action="store_true")
        sp.add_argument("--quiet", action="store_true")
        sp.add_argument("--no-progress", action="store_true")
        sp.add_argument("--min-severity", choices=SEVERITIES, default="minor")
        sp.add_argument("--category", action="append", help="filter category (repeatable)")
        sp.add_argument("--rule", action="append", help="filter rule id (repeatable)")
        sp.add_argument("--exclude", action="append", help="glob to exclude (repeatable)")
        sp.add_argument("--max-files", type=int, default=20000)
        sp.add_argument("--max-file-bytes", type=int, default=1500000)
        sp.add_argument("--max-per-file-rule", type=int, default=5)
        sp.add_argument("--max-per-rule", type=int, default=200)
        sp.add_argument("--cve", action="store_true", help=cve_help)
        sp.add_argument("--since", metavar="REF",
                        help="also score findings on lines changed since this git ref (new-code view)")
        sp.add_argument("--config", metavar="PATH",
                        help="explicit .jankhunt.toml/.jankhunt.json (default: discovered upward from root)")
        sp.add_argument("--no-config", action="store_true", help="ignore any .jankhunt.toml/.jankhunt.json")
        sp.add_argument("--calibrate", action="store_true",
                        help="apply and update the repo-local FP calibration ledger (.jankhunt/calibration.json); "
                             "the only flag besides --cve that writes anything")

    def add_scan_opts(sp):
        sp.add_argument("paths", nargs="*", help="files or directories (default: .)")
        sp.add_argument("--json", action="store_true", help="machine-readable JSON")
        sp.add_argument("--sarif", action="store_true", help="SARIF 2.1.0 for CI code scanning")
        sp.add_argument("--md", action="store_true", help="force Markdown output")
        sp.add_argument("--html", action="store_true", help="self-contained HTML report (stdout)")
        add_common_scan_inputs(sp, "query OSV.dev for pinned dependency advisories (network)")
        sp.add_argument("--max-findings", type=int, default=300,
                        help="display cap (JSON/SARIF keep all)")
        sp.add_argument("--fail-on", choices=SEVERITIES,
                        help="exit 1 if a finding meets this severity")

    sp = sub.add_parser("scan", help="scan code, infra, CI, and config")
    add_scan_opts(sp)
    sp.set_defaults(func=cmd_scan)

    sp = sub.add_parser("score", help="show the Jank Score 2.0 breakdown (dimensions, grades, policy)")
    sp.add_argument("paths", nargs="*", help="files or directories (default: .)")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--md", action="store_true")
    add_common_scan_inputs(sp, "include OSV.dev advisories (network)")
    sp.add_argument("--fail-policy", action="store_true",
                    help="exit 1 when the advisory policy is 'fail' (not a substitute for --fail-on)")
    sp.set_defaults(func=cmd_score)

    def add_review_scan_inputs(sp):
        sp.add_argument("--no-color", action="store_true")
        sp.add_argument("--quiet", action="store_true")
        sp.add_argument("--no-progress", action="store_true")
        sp.add_argument("--min-severity", choices=SEVERITIES, default="minor")
        sp.add_argument("--category", action="append", help="filter category (repeatable)")
        sp.add_argument("--rule", action="append", help="filter rule id (repeatable)")
        sp.add_argument("--exclude", action="append", help="glob to exclude (repeatable)")
        sp.add_argument("--max-files", type=int, default=20000)
        sp.add_argument("--max-file-bytes", type=int, default=1500000)
        sp.add_argument("--max-per-file-rule", type=int, default=5)
        sp.add_argument("--max-per-rule", type=int, default=200)
        # Deliberately no --config/--calibrate here: `review` has its own
        # evidence-gated receipt pipeline (jh_review.py) that these do not
        # yet reach. Accepting the flags without wiring them would silently
        # do nothing, which is worse than not offering them.

    sp = sub.add_parser("review", help="diff-aware review with receipts, coverage, and baseline deltas")
    sp.add_argument("paths", nargs="*", help="repository root or path filter (default: .)")
    group = sp.add_mutually_exclusive_group()
    group.add_argument("--base", metavar="REF",
                       help="review REF...HEAD (committed changes since a base ref)")
    group.add_argument("--commit", metavar="SHA", help="review a single commit")
    group.add_argument("--staged", action="store_true", help="review the index only")
    group.add_argument("--pr", metavar="N", help="review a checked-out GitHub PR by number or URL")
    sp.add_argument("--json", action="store_true", help="machine-readable review receipts")
    sp.add_argument("--sarif", action="store_true", help="SARIF 2.1.0 with receipt fingerprints")
    sp.add_argument("--md", action="store_true", help="force Markdown output")
    sp.add_argument("--brief", action="store_true", help="Markdown review brief for the host agent")
    add_review_scan_inputs(sp)
    sp.add_argument("--max-findings", type=int, default=300, help="display cap (JSON/SARIF keep all)")
    sp.add_argument("--baseline", metavar="PATH", help="prior scan/review JSON for new-vs-persisting deltas")
    sp.add_argument("--save-baseline", metavar="PATH", help="write the current review as the next baseline")
    sp.add_argument("--fail-on", choices=SEVERITIES,
                    help="exit 1 for new supported findings at or above this severity")
    sp.add_argument("--include-unverified", action="store_true",
                    help="include unverified leads in the --fail-on gate")
    sp.add_argument("--no-supply-chain", action="store_true", help="skip SBOM/attestation evidence discovery")
    sp.add_argument("--no-supply-chain-discovery", action="store_true",
                    help="only inspect explicitly supplied evidence files")
    sp.add_argument("--sbom", action="append", metavar="PATH", help="explicit SBOM path (repeatable)")
    sp.add_argument("--attestation", action="append", metavar="PATH",
                    help="explicit in-toto/Sigstore/GitHub attestation path (repeatable)")
    sp.add_argument("--jfrog-evidence", action="append", metavar="PATH",
                    help="explicit JFrog AppTrust evidence path (repeatable)")
    sp.add_argument("--require-sbom", action="store_true", help="fail if no SBOM is found")
    sp.add_argument("--require-attestation", action="store_true", help="fail if no attestation is found")
    sp.add_argument("--require-verified-attestation", action="store_true",
                    help="fail unless the exporter recorded a successful verification")
    sp.set_defaults(func=cmd_review)

    sp = sub.add_parser("supply-chain", help="inspect SPDX/CycloneDX SBOMs, GitHub/Sigstore attestations, and JFrog evidence")
    sp.add_argument("paths", nargs="*", help="repository root (default: .)")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--md", action="store_true")
    sp.add_argument("--no-color", action="store_true")
    sp.add_argument("--no-discover", action="store_true", help="only inspect explicit evidence paths")
    sp.add_argument("--sbom", action="append", metavar="PATH", help="explicit SBOM path (repeatable)")
    sp.add_argument("--attestation", action="append", metavar="PATH",
                    help="explicit attestation path (repeatable)")
    sp.add_argument("--jfrog-evidence", action="append", metavar="PATH",
                    help="explicit JFrog evidence path (repeatable)")
    sp.add_argument("--require-sbom", action="store_true")
    sp.add_argument("--require-attestation", action="store_true")
    sp.add_argument("--require-verified-attestation", action="store_true")
    sp.set_defaults(func=cmd_supply_chain)

    sp = sub.add_parser("hunt", help="plan an opt-in adversarial deep hunt (agent prompts + consensus contract)")
    sp.add_argument("paths", nargs="*", help="files or directories (default: .)")
    sp.add_argument("--focus", choices=("all", "security", "reliability", "performance", "data", "ci"),
                    default="all", help="panel lens (default: all)")
    sp.add_argument("--panel", type=int, default=6, help="number of independent panelists (3-12)")
    sp.add_argument("--rounds", type=int, default=3, help="hunt rounds (2-5)")
    sp.add_argument("--max-agents", type=int, help="hard cap on spawned agents (default: panel size)")
    sp.add_argument("--leads", type=int, default=12, help="scanner leads included in each prompt")
    sp.add_argument("--prompts", action="store_true", help="include the full agent prompt pack in Markdown output")
    sp.add_argument("--out", help="write the brief to this path (.json writes JSON)")
    sp.add_argument("--no-scan", action="store_true", help="plan without running the scanner")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--md", action="store_true")
    add_common_scan_inputs(sp, "include OSV.dev advisories in the lead board (network)")
    sp.set_defaults(func=cmd_hunt)

    sp = sub.add_parser("merge", help="merge panel JSON into an evidence-weighted consensus board")
    sp.add_argument("paths", nargs="*", help="panel/scan JSON or JSONL files (- for stdin)")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--md", action="store_true")
    sp.add_argument("--no-color", action="store_true")
    sp.add_argument("--fail-on", choices=SEVERITIES,
                    help="exit 1 if a confirmed finding meets this severity")
    sp.set_defaults(func=cmd_merge)

    sp = sub.add_parser("triage", help="parse, fingerprint, and rank logs")
    sp.add_argument("paths", nargs="*", help="log files, .gz, or - for stdin")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--md", action="store_true")
    sp.add_argument("--no-color", action="store_true")
    sp.add_argument("--top", type=int, default=30)
    sp.add_argument("--grep", help="only consider lines matching this regex")
    sp.set_defaults(func=cmd_triage)

    sp = sub.add_parser("doctor", help="project + system environment health")
    sp.add_argument("path", nargs="?", default=".")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--md", action="store_true")
    sp.add_argument("--no-color", action="store_true")
    sp.add_argument("--system", action="store_true", help="include ports, failed units, kernel log")
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("report", help="scan + doctor + logs → Markdown investigation report")
    sp.add_argument("paths", nargs="*")
    sp.add_argument("--logs", action="append", help="log file(s) to triage (repeatable)")
    sp.add_argument("--out", help="write report to this path")
    sp.add_argument("--system", action="store_true")
    sp.add_argument("--md", action="store_true")
    add_common_scan_inputs(sp, "include OSV.dev advisories (network)")
    sp.add_argument("--max-findings", type=int, default=300)
    sp.add_argument("--fail-on", choices=SEVERITIES)
    sp.set_defaults(func=cmd_report)

    sp = sub.add_parser("rules", help="print the rule catalog")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--category", action="append")
    sp.add_argument("--min-severity", choices=SEVERITIES, default="info")
    sp.set_defaults(func=cmd_rules)
    return p


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except KeyboardInterrupt:
        print("\njankhunt: interrupted", file=sys.stderr)
        return 130
    except BrokenPipeError:
        # The reader (e.g. `| head` or `| grep -q`) closed its end early
        # and an explicit write caught the EPIPE synchronously. Nothing
        # more to do here; the shutdown-flush guard below still applies,
        # since Python may still hold buffered output from before this
        # point.
        return 0


if __name__ == "__main__":
    _code = main()
    # Most output goes through buffered print() calls that don't hit the
    # OS pipe until flushed, so a reader closing early (e.g. `| grep -q`)
    # is usually invisible here: main() returns 0 with no exception ever
    # raised. The failure instead surfaces when CPython flushes stdout
    # during interpreter shutdown, which is outside any try/except we can
    # write around main() and makes CPython set exit status 120 itself
    # (see Modules/main.c), overriding whatever _code was. Flush explicitly
    # now, while it is still ours to catch, and sink further writes to
    # /dev/null so the later implicit shutdown flush is a no-op instead of
    # raising again.
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
    sys.exit(_code)
