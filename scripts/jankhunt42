    sp.add_argument("--min-severity", choices=SEVERITIES, default="info")
    sp.set_defaults(func=cmd_rules)
    return p


# commands whose positional arguments are files or directories to read
# (review's are path filters, which may name a deleted file)
_PATH_COMMANDS = ("scan", "score", "supply-chain", "hunt", "report", "doctor", "map", "passport")


def _unreadable(path: str) -> str:
    """Why a path argument cannot be read, or "" when it can."""
    path = os.path.expanduser(path)
    try:
        os.stat(path)
    except OSError as exc:
        return "broken symbolic link" if os.path.islink(path) else (exc.strerror or "cannot be read").lower()
    if not os.access(path, os.R_OK | (os.X_OK if os.path.isdir(path) else 0)):
        return "permission denied"
    return ""


def main(argv: Optional[Sequence[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command in _PATH_COMMANDS:
        # a mistyped or unreadable path must not become a clean scan of the working directory
        given = getattr(args, "paths", None) or [getattr(args, "path", None) or "."]
        unreadable = [p + ": " + why for p, why in ((p, _unreadable(p)) for p in given) if why]
        if unreadable:
            print("jankhunt42: cannot read %s" % "; ".join(unreadable), file=sys.stderr)
            return 2
    try:
        return int(args.func(args))
    except KeyboardInterrupt:
        print("\njankhunt: interrupted", file=sys.stderr)
        return 130
    except BrokenPipeError:
        # The reader (e.g. `| head` or `| grep -q`) closed its end early
        # and an explicit write caught the EPIPE synchronously. Nothing
        # more to do here; the shutdown-flush guard below still applies,
        # since Python may still hold buffered output from before this
        # point.
        return 0


if __name__ == "__main__":
    _code = main()
    # Most output goes through buffered print() calls that don't hit the
    # OS pipe until flushed, so a reader closing early (e.g. `| grep -q`)
    # is usually invisible here: main() returns 0 with no exception ever
    # raised. The failure instead surfaces when CPython flushes stdout
    # during interpreter shutdown, which is outside any try/except we can
    # write around main() and makes CPython set exit status 120 itself
    # (see Modules/main.c), overriding whatever _code was. Flush explicitly
    # now, while it is still ours to catch, and sink further writes to
    # /dev/null so the later implicit shutdown flush is a no-op instead of
    # raising again.
    try:
        sys.stdout.flush()
    except BrokenPipeError:
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
    sys.exit(_code)
