class Spinner:
    FRAMES = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"

    def __init__(self, enabled: bool):
        self.enabled = enabled
        self.i = 0
        self.last = 0.0

    def update(self, text: str) -> None:
        if not self.enabled:
            return
        now = time.time()
        if now - self.last < 0.07:
            return
        self.last = now
        frame = self.FRAMES[self.i % len(self.FRAMES)]
        self.i += 1
        sys.stderr.write("\r\x1b[2K  \x1b[38;5;51m%s\x1b[0m %s" % (frame, text))
        sys.stderr.flush()

    def done(self) -> None:
        if self.enabled:
            sys.stderr.write("\r\x1b[2K")
            sys.stderr.flush()


def _manifest_files(root: str, max_depth: int = 4) -> List[Tuple[str, str]]:
    names = {
        "package.json", "package-lock.json", "npm-shrinkwrap.json", "yarn.lock",
        "pnpm-lock.yaml", "bun.lockb", "requirements.txt", "pyproject.toml",
        "pipfile.lock", "poetry.lock", "cargo.lock", "go.mod", "pom.xml",
        "build.gradle", "build.gradle.kts", "gemfile.lock", "composer.lock",
        "pubspec.lock",
    }
    out: List[Tuple[str, str]] = []
    base = os.path.abspath(root)
    for dirpath, dirnames, filenames in os.walk(base):
        rel_dir = os.path.relpath(dirpath, base)
        depth = 0 if rel_dir == "." else rel_dir.count(os.sep) + 1
        if depth > max_depth:
            dirnames[:] = []
            continue
        dirnames[:] = [d for d in dirnames if d not in {
            "node_modules", ".git", "vendor", "dist", "build", "target", ".venv",
            "venv", "__pycache__", ".tox", ".gradle", "Pods", "DerivedData",
        } and not d.startswith(".")]
        for fn in filenames:
            low = fn.lower()
            if low in names or low.endswith((".csproj", ".fsproj", ".vbproj")):
                path = os.path.join(dirpath, fn)
                rel = os.path.relpath(path, base).replace(os.sep, "/")
                out.append((path, rel))
    return out


def _probe_root(paths: Sequence[str]) -> str:
    """Cheap, deterministic preview of the root discover_files() will land
    on, needed only so config discovery can happen before the real scan."""
    from pathlib import Path as _Path
    roots = [_Path(p).expanduser().resolve() for p in (paths or ["."])]
    if len(roots) == 1 and roots[0].is_dir():
        return str(roots[0])
    return str(_Path.cwd().resolve())


def _load_sources(paths: Sequence[str], excludes: Sequence[str], max_files: int, max_bytes: int,
                  spinner: Optional[Spinner] = None) -> Tuple[Any, List[Any], int]:
    root, files = discover_files(paths, excludes=excludes, max_files=max_files, max_bytes=max_bytes)
    if spinner:
        spinner.update("reading %d files…" % len(files))
    sources = []
    skipped = 0
    for idx, path in enumerate(files, 1):
        sf = load_source(path, root)
        if sf is None:
            skipped += 1
        else:
            sources.append(sf)
        if spinner and idx % 17 == 0:
            spinner.update("reading %d/%d  %s" % (idx, len(files), os.path.basename(str(path))))
    return root, sources, skipped


def _globbed(rel: str, patterns: Sequence[str]) -> bool:
    return any(fnmatch.fnmatch(rel, p) or fnmatch.fnmatch(os.path.basename(rel), p) for p in patterns)


def run_scan(args: argparse.Namespace, spinner: Optional[Spinner] = None,
             preloaded: Optional[Tuple[Any, List[Any], int]] = None,
             cfg: Optional[Any] = None) -> Tuple[str, ScanResult, Dict[str, object]]:
    """Scan with repository config applied. `preloaded` is (root, sources,
    skipped) already discovered with the config's ignore globs applied;
    `cfg` is a config the caller already loaded (and reported)."""
    t0 = time.time()
    if cfg is None:
        cfg = jh_config.load_config_for_root(
            _probe_root(args.paths),
            explicit_path=getattr(args, "config", None),
            disabled=getattr(args, "no_config", False),
        )
        jh_config.emit_warnings(cfg)
    if preloaded is not None:
        root, sources, skipped = preloaded
    else:
        root, sources, skipped = _load_sources(args.paths, list(args.exclude or ()) + cfg.ignore_globs,
                                               args.max_files, args.max_file_bytes, spinner)
    if spinner:
        spinner.update("scanning %d files with %d rules…" % (len(sources), len(RULES)))
    opts = ScanOptions(
        min_severity=args.min_severity,
        categories=set(args.category) if args.category else None,
        rule_ids=set(args.rule) if args.rule else None,
        max_per_file_rule=args.max_per_file_rule,
        max_per_rule=args.max_per_rule,
        honor_suppressions=getattr(args, "honor_suppressions", True),
    )
    result = scan_sources(sources, opts)
    if cfg.source:
        result.findings = jh_config.apply_to_findings(cfg, result.findings)
        result.findings.sort(key=lambda f: f.sort_key())
    meta: Dict[str, object] = {
        "root": str(root),
        "elapsed": time.time() - t0,
        "skipped": skipped,
        "cve": bool(args.cve),
    }
    if cfg.source:
        meta["config"] = cfg.source
    meta["cross_file_duplicates"] = [c.to_dict() for c in jh_dedup.find_cross_file_duplicates(result.findings)]
    meta["minified"] = sorted(sf.rel for sf in sources if "minified" in sf.kinds)
    if getattr(args, "calibrate", False):
        ledger = jh_calibrate.load_ledger(str(root))
        notes = jh_calibrate.apply_calibration(result.findings, ledger, SEVERITIES)
        result.findings.sort(key=lambda f: f.sort_key())
        jh_calibrate.update_ledger(ledger, result.fired_by_rule, result.suppressed_by_rule)
        jh_calibrate.save_ledger(str(root), ledger)
        meta["calibration"] = {
            "ledger": jh_calibrate.ledger_path(str(root)),
            "downgrades": [n.to_dict() for n in notes],
        }
    if args.cve:
        manifests = _manifest_files(str(root))
        deps = jh_cve.collect_dependencies(manifests)
        if not deps:
            meta["cve_warnings"] = ["no pinned dependencies found in known manifests"]
        else:
            cve = jh_cve.query_osv(deps)
            result.findings.extend(cve.findings)
            result.findings.sort(key=lambda f: f.sort_key())
            meta["cve_packages"] = cve.packages
            meta["cve_queried"] = cve.queried
            if cve.warnings:
                meta["cve_warnings"] = cve.warnings
    since = getattr(args, "since", None)
    if since:
        changed, warning = jh_score.changed_lines(str(root), since)
        if changed is None:
            meta["new_code"] = {"since": since, "warning": warning}
        else:
            _, new_meta = jh_score.compute_new_code(result.findings, changed, since)
            meta["new_code"] = new_meta
    meta["elapsed"] = time.time() - t0
    if spinner:
        spinner.done()
    return str(root), result, meta


def _scan_json(root: str, result: ScanResult, meta: Dict[str, object]) -> str:
    counts: Dict[str, int] = {}
    for f in result.findings:
        counts[f.severity] = counts.get(f.severity, 0) + 1
    score = jh_score.compute(result.findings, result.loc)
    if meta.get("new_code"):
        score.new_code = meta["new_code"]
    data = {
        "tool": TOOL,
        "version": VERSION,
        "command": "scan",
        "root": root,
        "summary": {
            "files": result.files,
            "loc": result.loc,
            "findings": len(result.findings),
            "counts": counts,
            "jank_score": score.score,
            "jank": score.to_dict(),
            "elapsed_seconds": round(float(meta.get("elapsed", 0)), 3),
            "cve": meta.get("cve", False),
            "cve_packages": meta.get("cve_packages", 0),
        },
        "warnings": meta.get("cve_warnings", []),
        "config": meta.get("config"),
        "cross_file_duplicates": meta.get("cross_file_duplicates", []),
        "minified": meta.get("minified", []),
        "calibration": meta.get("calibration"),
        "findings": [asdict(f) for f in result.findings],
    }
    return json.dumps(data, indent=2, ensure_ascii=False)


def _sarif(result: ScanResult) -> str:
    levels = {"blocker": "error", "critical": "error", "major": "warning", "minor": "note", "info": "note"}
    rules = {}
    results = []
    for f in result.findings:
        rule = rule_by_id(f.rule)
        if f.rule not in rules:
            rules[f.rule] = {
                "id": f.rule,
                "name": f.title,
                "shortDescription": {"text": f.title},
                "fullDescription": {"text": rule.message if rule else f.message},
                "help": {"text": f.fix or (rule.fix if rule else "")},
                "properties": {
                    "category": f.category,
                    "severity": f.severity,
                    "confidence": f.confidence,
                    "tags": list(f.tags),
                },
            }
        results.append({
            "ruleId": f.rule,
            "level": levels.get(f.severity, "note"),
            "message": {"text": f.message or f.title},
            "locations": [{
                "physicalLocation": {
                    "artifactLocation": {"uri": urllib.parse.quote(f.path.replace(os.sep, "/"), safe="/")},
                    "region": {
                        "startLine": max(1, f.line),
                        "startColumn": max(1, f.column),
                        **({"endLine": f.end_line} if f.end_line else {}),
                    },
                }
            }],
            "partialFingerprints": {"jankhunt42": "%s:%s:%d" % (f.rule, f.path, f.line)},
            "properties": {
                "severity": f.severity,
                "confidence": f.confidence,
                "evidence": f.evidence,
                "fix": f.fix,
                "tags": list(f.tags),
            },
        })
    sarif = {
        "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
        "version": "2.1.0",
        "runs": [{
            "tool": {"driver": {
                "name": "jankhunt42",
                "version": VERSION,
                "rules": list(rules.values()),
            }},
            "results": results,
        }],
    }
    return json.dumps(sarif, indent=2, ensure_ascii=False)


def cmd_scan(args: argparse.Namespace) -> int:
    formats = sum(1 for enabled in (args.md, args.json, args.sarif, args.html) if enabled)
    if formats > 1:
        print("jankhunt42: choose one output format: --md, --json, --sarif, or --html",
              file=sys.stderr)
        return 2
    tty = sys.stdout.isatty() and not args.md and not args.json and not args.sarif and not args.html
    spinner = Spinner(tty and not args.quiet and not args.no_progress)
    root, result, meta = run_scan(args, spinner)
    if args.json:
        print(_scan_json(root, result, meta))
    elif args.sarif:
        print(_sarif(result))
    elif args.html:
        print(jh_html.render_scan(result, meta, args.max_findings))
    else:
        no_color = args.no_color or not tty
        print(jh_render.render_scan(result, meta, tty, no_color, args.max_findings))
    if args.fail_on:
        for f in result.findings:
            if sev_at_least(f.severity, args.fail_on):
                return 1
    return 0


def cmd_review(args: argparse.Namespace) -> int:
    formats = sum(1 for enabled in (args.md, args.json, args.sarif, args.brief) if enabled)
    if formats > 1:
        print("jankhunt42: choose one output format: --md, --json, --sarif, or --brief",
              file=sys.stderr)
        return 2
    try:
        data = jh_review.run_review(args)
    except jh_review.ReviewError as exc:
        print("jankhunt42: %s" % exc, file=sys.stderr)
        return 2
    if getattr(args, "save_baseline", ""):
        try:
            with open(args.save_baseline, "w", encoding="utf-8") as fh:
                json.dump(data, fh, indent=2, ensure_ascii=False)
                fh.write("\n")
            if not args.json:
                print("review baseline written: %s" % args.save_baseline, file=sys.stderr)
        except OSError as exc:
            print("jankhunt42: cannot write baseline: %s" % exc, file=sys.stderr)
            return 2
    review = data["review"]
    if args.json:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    elif args.sarif:
        print(jh_review.sarif(review))
    elif args.brief:
        print(jh_review.brief(review))
    elif args.md:
        print(jh_review.markdown(review, args.max_findings))
    else:
        tty = sys.stdout.isatty()
        if tty:
            print(jh_review.tty(review, args.max_findings, args.no_color))
        else:
            print(jh_review.markdown(review, args.max_findings))
    return 1 if review["gate"]["result"] == "fail" else 0


def cmd_supply_chain(args: argparse.Namespace) -> int:
    formats = sum(1 for enabled in (args.md, args.json) if enabled)
    if formats > 1:
        print("jankhunt42: choose one output format: --md or --json", file=sys.stderr)
        return 2
    root = os.path.abspath(args.paths[0] if args.paths else ".")
    if os.path.isfile(root):
        root = os.path.dirname(root)
    requirements = {
        "sbom": bool(args.require_sbom),
        "sbom_minimum": bool(getattr(args, "require_sbom_minimum", False)),
        "attestation": bool(args.require_attestation),
        "verified_attestation": bool(args.require_verified_attestation),
    }
    kwargs = dict(sbom_paths=args.sbom or (), attestation_paths=args.attestation or (),
                  jfrog_paths=args.jfrog_evidence or (), requirements=requirements,
                  discover=not args.no_discover)
    try:
        report = _supply_with_verification(root, args, kwargs)
    except ValueError as exc:
        print("jankhunt42: supply-chain: %s" % jh_core_safe(str(exc)), file=sys.stderr)
        return 2
    payload = {
        "tool": TOOL,
        "version": VERSION,
        "command": "supply-chain",
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        **report,
    }
    if args.json:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    elif args.md or not sys.stdout.isatty():
        print(jh_supply.markdown(report))
    else:
        color = jh_render.Colors(not args.no_color)
        print(color.bold("SUPPLY-CHAIN EVIDENCE") + "  " + color.grey(root))
        print("  " + jh_supply.summary_line(report))
        print("")
        print(jh_supply.markdown(report, heading="## Evidence"))
    return 1 if report["gate"]["result"] == "fail" else 0


def _supply_with_verification(root: str, args: argparse.Namespace, kwargs: Dict[str, object]) -> Dict[str, object]:
    """Plain offline inspection, or --verify PLAN: native verifiers, plus
    fetching only with --online. Raises ValueError for usage problems."""
    plan_path = getattr(args, "verify", None)
    if not plan_path:
        if getattr(args, "online", False) or getattr(args, "fetch_dir", None):
            raise ValueError("--online and --fetch-dir need --verify PLAN")
        return jh_supply.inspect(root, **kwargs)
    import jh_verify
    plan = jh_verify.load_plan(plan_path, root)  # PlanError is a ValueError
    return jh_verify.verify_supply(root, plan, bool(args.online), getattr(args, "fetch_dir", None), **kwargs)


def cmd_score(args: argparse.Namespace) -> int:
    tty = sys.stdout.isatty() and not args.json and not args.md
    spinner = Spinner(tty and not args.quiet and not args.no_progress)
    root, result, meta = run_scan(args, spinner)
    report = jh_score.compute(result.findings, result.loc)
    if meta.get("new_code"):
        report.new_code = meta["new_code"]
    if args.json:
        data = {
            "tool": TOOL,
            "version": VERSION,
            "command": "score",
            "root": root,
            "files": result.files,
            "loc": result.loc,
            "jank": report.to_dict(),
            "warnings": meta.get("cve_warnings", []),
            "config": meta.get("config"),
            "cross_file_duplicates": meta.get("cross_file_duplicates", []),
            "calibration": meta.get("calibration"),
        }
        print(json.dumps(data, indent=2, ensure_ascii=False))
    elif tty and not args.no_color:
        color = jh_render.Colors(True)
        width = jh_render._width()
        header = jh_render.banner(
            "jank score // weakest link first",
            "%s  ·  %s files  ·  %s LOC" % (root, f"{result.files:,}", f"{result.loc:,}"),
            color, width,
        )
        print("\n".join(header + [""] + jh_score.scorecard_tty(report, color, width)))
    else:
        print(jh_score.scorecard_markdown(report))
    if args.fail_policy and report.policy == "fail":
        return 1
    return 0


def cmd_hunt(args: argparse.Namespace) -> int:
    tty = sys.stdout.isatty() and not args.md and not args.json
    spinner = None if args.no_scan else Spinner(tty and not args.quiet and not args.no_progress)
    if args.no_scan:
        root = os.path.abspath(args.paths[0] if args.paths else ".")
        result = ScanResult()
        meta: Dict[str, object] = {"elapsed": 0.0, "cve": False}
    else:
        root, result, meta = run_scan(args, spinner)
    plan = jh_hunt.build_plan(
        root, result, meta,
        focus=args.focus,
        panel=args.panel,
        rounds=args.rounds,
        max_agents=args.max_agents,
        lead_limit=args.leads,
        include_prompts=True,
        scope=args.paths or [root],
        exclusions=args.exclude or (),
    )
    if args.json:
        content = json.dumps(plan, indent=2, ensure_ascii=False)
        print(content)
    elif tty and not args.no_color:
        print(jh_hunt.hunt_tty(plan))
    else:
        print(jh_hunt.hunt_markdown(plan, include_prompts=args.prompts))
    if args.out:
        if args.json or (not args.md and args.out.endswith(".json")):
            payload = json.dumps(plan, indent=2, ensure_ascii=False)
        else:
            payload = jh_hunt.hunt_markdown(plan, include_prompts=args.prompts)
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write(payload + "\n")
        print("hunt brief written: %s" % args.out, file=sys.stderr)
        print("  focus: %s · panelists: %d · leads: %d · rounds: %d"
              % (plan["focus"], len(plan["roles"]), len(plan["leads"]), len(plan["rounds"])),
              file=sys.stderr)
    return 0


def cmd_merge(args: argparse.Namespace) -> int:
    paths = list(args.paths)
    if not paths:
        if not sys.stdin.isatty():
            paths = ["-"]
        else:
            print("jankhunt42: give at least one panel JSON file (or pipe via stdin)", file=sys.stderr)
            return 2
    try:
        reports = jh_hunt.load_reports(paths)
    except (OSError, ValueError) as exc:
        print("jankhunt42: %s" % exc, file=sys.stderr)
        return 2
    merged = jh_hunt.merge_reports(reports)
    if args.json:
        print(json.dumps(merged, indent=2, ensure_ascii=False))
    else:
        tty = sys.stdout.isatty() and not args.md
        if tty and not args.no_color:
            print(jh_hunt.merge_tty(merged))
        else:
            print(jh_hunt.merge_markdown(merged))
    if args.fail_on:
        for f in merged["findings"]:
            if f["status"] == "confirmed" and sev_at_least(f["severity"], args.fail_on):
                return 1
    return 0


def cmd_triage(args: argparse.Namespace) -> int:
    paths = list(args.paths)
    if not paths:
        if not sys.stdin.isatty():
            paths = ["-"]
        else:
            print("jankhunt42: give at least one log file (or pipe via stdin)", file=sys.stderr)
            return 2
    result = jh_triage.triage_paths(paths, grep=args.grep)
    if args.json:
        print(jh_triage.triage_json(result, args.top))
    else:
        tty = sys.stdout.isatty() and not args.md
        print(jh_render.render_triage(result, tty, args.no_color or not tty, args.top))
    return 0


def cmd_doctor(args: argparse.Namespace) -> int:
    result = jh_doctor.doctor(args.path or ".", deep=args.system)
    if args.json:
        print(jh_doctor.doctor_json(result))
    else:
        tty = sys.stdout.isatty() and not args.md
        print(jh_render.render_doctor(result, tty, args.no_color or not tty))
    return 0


def cmd_rules(args: argparse.Namespace) -> int:
    rows = [r for r in RULES if (not args.category or r.category in args.category)
            and sev_at_least(r.severity, args.min_severity)]
    if args.json:
        print(json.dumps([{
            "id": r.id, "title": r.title, "severity": r.severity, "category": r.category,
            "confidence": r.confidence, "message": r.message, "fix": r.fix,
            "tags": list(r.tags), "dynamic": r.id == "JH901",
        } for r in rows], indent=2, ensure_ascii=False))
        return 0
    print("# jankhunt42 rule catalog\n")
    print("| Rule | Severity | Category | Confidence | Title |")
    print("|---|---|---|---|---|")
    for r in rows:
        print("| `%s` | %s | %s | %s | %s |" % (r.id, r.severity, r.category, r.confidence, r.title))
    print("\n%d rules shown. `JH901` is populated by `scan --cve` (OSV.dev)." % len(rows))
    return 0


def _report_markdown(root: str, scan: ScanResult, meta: Dict[str, object],
                     doctor: jh_doctor.DoctorResult,
                     logs: Optional[jh_triage.TriageResult]) -> str:
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    counts: Dict[str, int] = {}
    for f in scan.findings:
        counts[f.severity] = counts.get(f.severity, 0) + 1
    score = jh_score.compute(scan.findings, scan.loc)
    if meta.get("new_code"):
        score.new_code = meta["new_code"]
    out: List[str] = []
    out.append("# jankhunt42 report")
    out.append("")
    out.append("**Root:** `%s` · **Generated:** %s · **Files:** %d · **LOC:** %d"
               % (root, now, scan.files, scan.loc))
    out.append("")
    out.append("## 1. Executive summary")
    out.append("")
    out.append(jh_score.scorecard_markdown(score, heading="### Jank score"))
    out.append("")
    out.append("**Findings:** %d — %s"
               % (len(scan.findings),
                  ", ".join("%s %d" % (s, counts[s]) for s in SEVERITIES if counts.get(s)) or "none"))
    top = jh_render._top_rules(scan.findings, 8)
    if top:
        out.append("")
        out.append("| Rule | Title | Count |")
        out.append("|---|---|---:|")
        for rid, title, count in top:
            out.append("| `%s` | %s | %d |" % (rid, title, count))
    if meta.get("cve_warnings"):
        out.append("")
        for warning in meta["cve_warnings"]:
            out.append("> CVE lookup: %s" % warning)
    out.append("")
    out.append("## 2. Environment")
    out.append("")
    from jh_doctor import doctor_markdown
    env = doctor_markdown(doctor).split("\n", 1)
    out.append(env[1] if len(env) > 1 else "")
    out.append("")
    out.append("## 3. Static findings")
    out.append("")
    body = jh_render.scan_markdown(scan, meta, max_findings=150).split("\n", 1)
    out.append(body[1] if len(body) > 1 else body[0])
    if logs is not None:
        out.append("")
        out.append("## 4. Log triage")
        out.append("")
        from jh_triage import triage_markdown
        log_md = triage_markdown(logs, top=20).split("\n", 1)
        out.append(log_md[1] if len(log_md) > 1 else log_md[0])
    out.append("")
    out.append("## 5. Investigation worksheet")
    out.append("")
    out.append("| Field | Value |")
    out.append("|---|---|")
    out.append("| Symptom (expected vs actual) | _fill_ |")
    out.append("| Exact repro command | _fill_ |")
    out.append("| Frequency / first seen | _fill_ |")
    out.append("| Last known good | _fill_ |")
    out.append("| Suspect change | _fill_ |")
    out.append("| Hypothesis H1 | _fill_ |")
    out.append("| Cheapest discriminating test | _fill_ |")
    out.append("| Root cause (proven) | _fill_ |")
    out.append("| Fix + regression test | _fill_ |")
    out.append("")
    out.append("## 6. Next moves")
    out.append("")
    out.append("1. Reproduce the failure and capture exit code + full stack trace.")
    out.append("2. Confirm the top severity findings in context; do not fix regex hits blindly.")
    out.append("3. Run the project's native compiler/tests/linter; compare against the last known good commit.")
    out.append("4. If the bug is intermittent, add timestamps/correlation IDs and measure frequency before changing code.")
    out.append("5. Record the causal chain and the verification command in the final report.")
    return "\n".join(out)


def cmd_report(args: argparse.Namespace) -> int:
    spinner = Spinner(sys.stdout.isatty() and not args.quiet and not args.no_progress)
    root, scan, meta = run_scan(args, spinner)
    spinner.update("checking the environment…")
    doc = jh_doctor.doctor(root, deep=args.system)
    logs = None
    if args.logs:
        logs = jh_triage.triage_paths(args.logs)
    report = _report_markdown(root, scan, meta, doc, logs)
    if args.out:
        spinner.done()
        with open(args.out, "w", encoding="utf-8") as fh:
            fh.write(report + "\n")
        counts: Dict[str, int] = {}
        for f in scan.findings:
            counts[f.severity] = counts.get(f.severity, 0) + 1
        score = jh_score.compute(scan.findings, scan.loc)
        print("report written: %s" % args.out)
        print("  files: %d · findings: %d · jank: %d/100 (%s · %s) · policy %s"
              % (scan.files, len(scan.findings), score.score, score.grade,
                 score.label, score.policy))
        if counts:
            print("  " + " · ".join("%s %d" % (s, counts[s]) for s in SEVERITIES if counts.get(s)))
    else:
        print(report)
    return 0


def _one_format(args: argparse.Namespace, names: Sequence[str]) -> bool:
    if sum(1 for n in names if getattr(args, n, False)) > 1:
        print("jankhunt42: choose one output format: %s" % ", ".join("--" + n for n in names), file=sys.stderr)
        return False
    return True


def _emit(args: argparse.Namespace, report: Dict[str, object], md, tty_view, html) -> None:
    if args.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
    elif args.html:
        print(html(report))
    elif args.md or not sys.stdout.isatty():
        print(md(report))
    else:
        color = jh_render.color_enabled(args.no_color)
        print(tty_view(report, color=color, ascii_only=jh_views.want_ascii()))


def _map_inputs(args: argparse.Namespace) -> Tuple[str, List[str], object]:
    root = os.path.abspath(args.path)
    if not os.path.isdir(root):
        raise ValueError("not a directory: %s" % args.path)
    cfg = jh_config.load_config_for_root(root, explicit_path=args.config, disabled=args.no_config)
    jh_config.emit_warnings(cfg)
    return root, list(args.exclude or ()) + cfg.ignore_globs, cfg


def cmd_map(args: argparse.Namespace) -> int:
    if not _one_format(args, ("json", "html", "md", "mermaid", "csv")):
        return 2
    if args.base and args.drift:
        print("jankhunt42: map: --base and --drift are mutually exclusive", file=sys.stderr)
        return 2
    depth = max(1, min(jh_graph.MAX_DEPTH, args.max_depth))
    try:
        root, excludes, cfg = _map_inputs(args)
        common = (root, [root], excludes, args.max_files, args.max_file_bytes, cfg.passport, args.inventory, depth)
        if args.drift:
            stored = jh_map.load_json_file(args.drift)
            report = jh_map.run_map(*common)
            report["delta"] = jh_map.drift(stored, report)
            report = jh_map.finalize_report(report)
        elif args.base:
            base = jh_map.run_map(*common, rev=args.base)
            report = jh_map.run_map(*common, rev="HEAD")
            report["delta"] = jh_graph.diff(base, report)
            if jh_map.git_dirty(root):
                report["warnings"] = sorted(set(report["warnings"]) | {
                    "working-tree changes are ignored in --base mode: both sides come from committed git objects"})
            report = jh_map.finalize_report(report)
        else:
            report = jh_map.run_map(*common)
        if args.what_if:
            report["whatif"] = jh_map.run_whatif(report, jh_map.load_json_file(args.what_if), depth)
            report = jh_map.finalize_report(report)
    except jh_map.GitError as exc:
        print("jankhunt42: map --base: %s" % jh_core_safe(str(exc)), file=sys.stderr)
        return 2
    except (OSError, ValueError) as exc:
        print("jankhunt42: map: %s" % jh_core_safe(str(exc)), file=sys.stderr)
        return 2
    if args.redact:
        report = jh_map.finalize_report(jh_graph.pseudonymize(report))
    if args.mermaid:
        print(jh_explorer.render_mermaid(report))
        return 0
    if args.csv:
        try:
            os.makedirs(args.csv, exist_ok=True)
            nodes_csv, edges_csv = jh_map.render_csv(report)
            for name, body in (("nodes.csv", nodes_csv), ("edges.csv", edges_csv)):
                with open(os.path.join(args.csv, name), "w", encoding="utf-8", newline="") as fh:
                    fh.write(body)
        except OSError as exc:
            print("jankhunt42: map --csv: %s" % jh_core_safe(str(exc)), file=sys.stderr)
            return 2
        print("wrote %s and %s" % (os.path.join(args.csv, "nodes.csv"), os.path.join(args.csv, "edges.csv")))
        return 0
    _emit(args, report, jh_map.markdown, jh_views.map_tty, jh_explorer.render_map)
    return 0


def jh_core_safe(text: str) -> str:
    from jh_core import safe_text
    return jh_graph.sanitize_text(safe_text(text), 300)


def _load_doc(path: str, what: str) -> Dict[str, object]:
    try:
        return jh_map.load_json_file(path)
    except (OSError, ValueError) as exc:
        raise ValueError("cannot read %s %s: %s" % (what, path, exc))


def _load_branch_rules(path: str) -> object:
    """A GitHub REST export: an object (ruleset, protection, wrapper) or a list
    (rulesets, or the active rules for a branch)."""
    try:
        if os.path.getsize(path) > 20_000_000:
            raise ValueError("larger than 20 MB")
        with open(path, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError) as exc:
        raise ValueError("cannot read branch rules %s: %s" % (path, exc))
    if not isinstance(data, (dict, list)):
        raise ValueError("cannot read branch rules %s: expected a JSON object or list" % path)
    return data


def _default_branch(root: str) -> str:
    """The remote's default branch from git, else main."""
    try:
        proc = run_git(["git", "-C", root, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return "main"
    name = proc.stdout.strip().split("/", 1)[-1] if proc.returncode == 0 else ""
    return name if re.fullmatch(r"[\w./\-]{1,100}", name or "") else "main"


def cmd_passport(args: argparse.Namespace) -> int:
    if (args.capability_approval is not None or args.emit_capability_approval) and not args.base:
        print("jankhunt42: passport: capability approval needs --base REF", file=sys.stderr)
        return 2
    if args.emit_capability_approval and (args.capability_approval is not None or args.json or args.md or args.html or
                                        args.acceptance or args.redact):
        print("jankhunt42: passport: approval template writes unsigned JSON; cannot combine a record, formats, acceptance or redaction",
              file=sys.stderr)
        return 2
    if args.base:
        if args.emit_sandbox_policy or args.compare or args.against or args.verify:
            print("jankhunt42: passport: --base cannot combine export, comparison or native verification", file=sys.stderr)
            return 2
        try:
            with jh_capabilities.snapshots(args) as snapshot:
                return _cmd_passport(args, snapshot)
        except (OSError, ValueError, jh_map.GitError) as exc:
            print("jankhunt42: passport: %s" % jh_core_safe(str(exc)), file=sys.stderr)
            return 2
    return _cmd_passport(args)


def _cmd_passport(args: argparse.Namespace, snapshot=None) -> int:
    if not _one_format(args, ("json", "html", "md")):
        return 2
    if args.sandbox_network_ceiling is not None and not args.base and args.emit_sandbox_policy not in ("openshell", "claude-code"):
        print("jankhunt42: passport: --sandbox-network-ceiling requires --emit-sandbox-policy openshell or claude-code",
              file=sys.stderr)
        return 2
    if args.emit_sandbox_policy and (args.json or args.html or args.md or args.compare or args.against):
        print("jankhunt42: passport: --emit-sandbox-policy writes the policy itself; it cannot be combined with "
              "--json, --html, --md or --compare", file=sys.stderr)
        return 2
    if args.against and not args.compare:
        print("jankhunt42: passport: --against needs --compare", file=sys.stderr)
        return 2
    if args.compare and args.html:
        print("jankhunt42: passport --compare supports --json or Markdown", file=sys.stderr)
        return 2
    if (args.online and not args.verify) or (args.verify and args.against):
        print("jankhunt42: passport: --online needs --verify, and --verify cannot be used with --against",
              file=sys.stderr)
        return 2
    if args.compare and args.against:
        try:
            delta = jh_passport.compare(_load_doc(args.compare, "passport"), _load_doc(args.against, "passport"))
        except ValueError as exc:
            print("jankhunt42: passport --compare: %s" % jh_core_safe(str(exc)), file=sys.stderr)
            return 2
        print(json.dumps(delta, indent=2, ensure_ascii=False) if args.json else jh_passport.compare_markdown(delta))
        return 0
    depth = max(1, min(jh_graph.MAX_DEPTH, args.max_depth))
    try:
        if snapshot:
            root, cfg = snapshot["root"], snapshot["cfg"]
            map_report, col = snapshot["map"], snapshot["col"]
        else:
            root, excludes, cfg = _map_inputs(args)
        network_ceiling = jh_ceiling.load(args.sandbox_network_ceiling, root) if args.sandbox_network_ceiling is not None else None
        if not snapshot:
            map_report, col = jh_map.run_map(root, [root], excludes, args.max_files, args.max_file_bytes,
                                         cfg.passport, args.inventory, depth, with_items=True)
    except (OSError, ValueError, jh_map.GitError) as exc:
        print("jankhunt42: passport: %s" % jh_core_safe(str(exc)), file=sys.stderr)
        return 2
    if args.emit_sandbox_policy:
        pkg = jh_registry.collect(col.items, root, list(args.exclude or ()) + list(cfg.ignore_globs or []))
        try:
            text, notes = jh_fence.emit(args.emit_sandbox_policy, map_report, pkg, VERSION, network_ceiling)
        except ValueError as exc:
            print("jankhunt42: passport: %s" % jh_core_safe(str(exc)), file=sys.stderr)
            return 2
        sys.stdout.write(text)
        for note in notes:
            print("jankhunt42: fence: %s" % jh_core_safe(note), file=sys.stderr)
        return 0
    scan_args = argparse.Namespace(
        paths=[root], exclude=args.exclude, max_files=args.max_files, max_file_bytes=args.max_file_bytes,
        min_severity="minor", category=None, rule=None, max_per_file_rule=5, max_per_rule=200, cve=False,
        since=None, config=args.config, no_config=args.no_config, calibrate=False)
    # Files are read once: the main scan sees the repository's tuning (its
    # ignore globs filter the same sources in memory), and the governance
    # scans run in memory on the governance rules only. Only when the
    # untuned discovery reaches --max-files is the tuned set discovered
    # again, so the main scan is never starved by ignored trees.
    scan_cfg = cfg
    operator_excludes = list(args.exclude or ())
    raw_pre = (root, [s for s in (jh_capabilities.source_from_text(i.rel, os.path.join(root, i.rel), i.text)
                    for i in col.items) if s is not None], 0) if snapshot else _load_sources(
                        [root], operator_excludes, args.max_files, args.max_file_bytes)
    raw_capped = len(raw_pre[1]) + raw_pre[2] >= args.max_files
    if not scan_cfg.ignore_globs:
        main_pre = raw_pre
    elif not raw_capped:
        main_pre = (raw_pre[0], [s for s in raw_pre[1] if not _globbed(s.rel, scan_cfg.ignore_globs)], raw_pre[2])
    elif not snapshot:
        main_pre = _load_sources([root], operator_excludes + scan_cfg.ignore_globs, args.max_files, args.max_file_bytes)
    else:
        main_pre = (root, [s for s in raw_pre[1] if not _globbed(s.rel, scan_cfg.ignore_globs)], raw_pre[2])
    _, result, _meta = run_scan(scan_args, preloaded=main_pre, cfg=scan_cfg)
    # Governance leads (P-SEC-001, P-AGT-001). Raw: the shipped rules with no
    # repository ignore globs, config, or inline pragmas, which is what the
    # citizen profile uses so the repository cannot opt out. Tuned: the same
    # rules as the repository configures them, to count what tuning hides.
    gov_rules = set(jh_passport.GOVERNANCE_RULES)
    raw = scan_sources(raw_pre[1], ScanOptions(min_severity="major", rule_ids=gov_rules, max_per_file_rule=1000,
                                               max_per_rule=100000, honor_suppressions=False)).findings
    tuned = jh_config.apply_to_findings(scan_cfg, scan_sources(main_pre[1], ScanOptions(
        min_severity="info", rule_ids=gov_rules, max_per_file_rule=1000, max_per_rule=100000)).findings)
    counts: Dict[str, int] = {}
    for f in result.findings:
        counts[f.severity] = counts.get(f.severity, 0) + 1
    jank = jh_score.compute(result.findings, result.loc).to_dict()
    try:
        supply = _supply_with_verification(snapshot["frozen"] if snapshot else root, args, {"discover": True})
    except ValueError as exc:
        print("jankhunt42: passport: %s" % jh_core_safe(str(exc)), file=sys.stderr)
        return 2
    operator, op_label, repo_extra, repo_paths, warnings = None, "", [], [], []
    if cfg.source and isinstance(cfg.passport.get("policy"), dict):
        repo_paths.append(os.path.basename(cfg.source))
    if args.policy:
        try:
            if snapshot and jh_map.inside(args.policy, jh_map.git_toplevel(root)):
                raise jh_policy.PolicyError("--base requires --policy outside the repository; committed passport policy remains tighten-only")
            pol = jh_policy.load_policy_file(args.policy)
        except jh_policy.PolicyError as exc:
            print("jankhunt42: passport: %s" % jh_core_safe(str(exc)), file=sys.stderr)
            return 2
        if jh_map.inside(args.policy, root):
            repo_extra.append(pol)
            repo_paths.append(os.path.relpath(os.path.realpath(args.policy), os.path.realpath(root)))
            warnings.append("--policy file is inside the scanned repository: applied tighten-only, like repository config")
        else:
            operator, op_label = pol, os.path.basename(args.policy)
    default_branch = args.default_branch or _default_branch(root)
    export, export_trusted, export_label = None, False, ""
    if args.branch_rules:
        try:
            if snapshot and jh_map.inside(args.branch_rules, jh_map.git_toplevel(root)):
                raise ValueError("--base requires --branch-rules outside the repository")
            export = _load_branch_rules(args.branch_rules)
        except ValueError as exc:
            print("jankhunt42: passport: %s" % jh_core_safe(str(exc)), file=sys.stderr)
            return 2
        export_trusted = not jh_map.inside(args.branch_rules, root)
        export_label = os.path.basename(args.branch_rules)
        if not export_trusted:
            warnings.append("--branch-rules file is inside the scanned repository: counted as declared, not "
                            "provider-verified")
    repo_name = os.path.basename(jh_map.git_toplevel(root) or root)
    change_control = jh_change.build(col.items, export, export_trusted, export_label, default_branch, repo_name)
    package_sources = jh_registry.collect(col.items, snapshot["frozen"] if snapshot else root,
                                          operator_excludes + list(scan_cfg.ignore_globs or []))
    capability_delta = jh_capabilities.not_requested()
    capability_approval_record = None
    if snapshot:
        context = dict(model=jh_capabilities.MODEL, analyzer=VERSION, policy=operator,
                       inventory=snapshot["inventory"], config=snapshot["operator_config"],
                       ceiling=sorted(network_ceiling) if network_ceiling is not None else None,
                       excludes=operator_excludes, max_files=args.max_files, max_bytes=args.max_file_bytes,
                       depth=depth, profile=args.profile, no_config=args.no_config,
                       branch_rules=export, default_branch=default_branch,
                       scope=os.path.relpath(root, jh_map.git_toplevel(root)))
        capability_delta = jh_capabilities.compare(*snapshot["reports"],
            *(c.items for c in snapshot["collections"]), network_ceiling, context)
        warnings.append("--base assesses committed HEAD; working-tree and untracked changes are excluded")
        if args.capability_approval is not None:
            capability_approval_record = jh_capability_approval.load(args.capability_approval, root)
    top = jh_map.git_toplevel(root)
    passport = jh_passport.build(
        name=os.path.basename(root) or "application",
        source_revision=capability_delta["head_sha"] if snapshot else jh_map.git_revision(root) if top else None,
        dirty=False if snapshot else jh_map.git_dirty(root) if top else None,
        items=col.items, scan_files=result.files, scan_loc=result.loc, jank=jank, findings_counts=counts,
        supply=supply, map_report=map_report, passport_cfg=cfg.passport,
        config_path=os.path.basename(cfg.source) if cfg.source else None,
        operator_policy=operator, operator_policy_label=op_label, repo_policy_paths=repo_paths,
        fail_on=args.fail_on, warnings=warnings, extra_repo_policies=repo_extra,
        findings=result.findings, governance_findings=raw, governance_tuned=tuned,
        governance_truncated=raw_capped, profile=args.profile, change_control=change_control,
        package_sources=package_sources, capability_delta=capability_delta,
        capability_approval_record=capability_approval_record,
        capability_approval_label=os.path.basename(args.capability_approval or ""))
    if args.emit_capability_approval:
        decision_policy = passport["assessment"]["decision"]["policy"]
        print(json.dumps(jh_capability_approval.template(capability_delta, decision_policy["effective"],
                                                       decision_policy["hash"]), indent=2))
        return 0
    if args.acceptance:
        try:
            record = _load_doc(args.acceptance, "acceptance record")
        except ValueError as exc:
            print("jankhunt42: passport: %s" % jh_core_safe(str(exc)), file=sys.stderr)
            return 2
        trusted = not jh_map.inside(args.acceptance, root)
        passport = jh_map.finalize_report(jh_passport.apply_acceptance(
            passport, record, trusted, os.path.basename(args.acceptance)))
    if args.redact:
        passport = jh_map.finalize_report(jh_passport.redact(passport))
    if args.compare:
        try:
            delta = jh_passport.compare(_load_doc(args.compare, "passport"), passport)
        except ValueError as exc:
            print("jankhunt42: passport --compare: %s" % jh_core_safe(str(exc)), file=sys.stderr)
            return 2
        print(json.dumps(delta, indent=2, ensure_ascii=False) if args.json else jh_passport.compare_markdown(delta))
        return 0
    _emit(args, passport, jh_passport.markdown, jh_views.passport_tty, jh_explorer.render_passport)
    return 1 if jh_policy.fails(passport["assessment"]["decision"]["result"], args.fail_on) else 0


def cmd_detonate(args: argparse.Namespace) -> int:
    """Opt-in: run the repository's install hooks and the commands that run when it is opened, in a disposable
    sandbox, and report what they try to do."""
    if not os.path.isdir(args.path):
        print("jankhunt42: detonate: %s is not a directory" % jh_core_safe(args.path), file=sys.stderr)
        return 2
    try:
        surfaces = jh_detonate.SURFACES if args.surface == "all" else (args.surface,)
        result = jh_detonate.run(args.path, image=args.image, engine=args.engine, timeout=args.timeout,
                                 surfaces=surfaces)
    except RuntimeError as exc:
        print("jankhunt42: detonate: %s" % jh_core_safe(str(exc)), file=sys.stderr)
        return 2
    result["version"] = VERSION
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(jh_detonate.render_markdown(result), end="")
    return 1 if result["counts"]["ALERT"] else 0


def cmd_selftest(args: argparse.Namespace) -> int:
    import jh_selftest
    return jh_selftest.main(args)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="jankhunt42",
        description="What's broken? What can it hurt? Can we responsibly ship it? "
                    "Offline investigation (scan, review, hunt), blast-radius maps (map), and software passports (passport).",
    )
    p.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    sub = p.add_subparsers(dest="command", required=True)

