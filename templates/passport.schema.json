{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloudbustinguk/jankhunt42/templates/passport.schema.json",
  "title": "jankhunt42 software passport (jankhunt.passport.v1)",
  "description": "Output of `jankhunt42 passport --json`: a local assessment, never an approval or certificate. lifecycle.state is draft, assessed, or accepted; accepted only with an operator acceptance record (outside the repository) bound to the same revision, policy hash, decision and, when given, artifact digest and environment. Acceptance is declared-by-operator, never verified.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "source_revision",
    "scan_id",
    "generated_at",
    "scope",
    "coverage",
    "warnings",
    "evidence",
    "truncation",
    "subject",
    "assessment",
    "ownership",
    "provenance",
    "data",
    "operations",
    "lifecycle",
    "remediation",
    "unknowns",
    "limitations",
    "graph_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "jankhunt.passport.v1"
      ]
    },
    "tool": {
      "type": "string",
      "enum": [
        "jankhunt42"
      ]
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "artifact_digests",
        "environment"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "root",
        "files_scanned",
        "loc",
        "redaction"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "evidence_areas",
        "evidence_areas_present",
        "evidence_areas_total",
        "map"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "state",
          "path",
          "line",
          "detail"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "observed",
              "declared",
              "inferred"
            ]
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "jank",
        "findings",
        "exposure",
        "decision"
      ],
      "properties": {
        "exposure": {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "Low",
                "Moderate",
                "High",
                "Critical",
                "Unknown"
              ]
            }
          }
        },
        "decision": {
          "type": "object",
          "required": [
            "result",
            "reasons",
            "rules",
            "mode",
            "policy",
            "note"
          ],
          "properties": {
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "review",
                "insufficient-evidence",
                "block"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule",
                  "title",
                  "outcome",
                  "message",
                  "evidence_refs",
                  "hard_floor"
                ],
                "properties": {
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "review",
                      "insufficient-evidence",
                      "block"
                    ]
                  }
                }
              }
            },
            "policy": {
              "type": "object",
              "required": [
                "hash",
                "effective",
                "sources"
              ]
            }
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "state",
        "owners",
        "declared_owners",
        "evidence_refs"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "observed",
            "declared",
            "unknown"
          ]
        }
      }
    },
    "operations": {
      "type": "object"
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "state",
        "acceptance"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "assessed",
            "accepted"
          ]
        },
        "acceptance": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not-supplied",
                "declared-by-operator",
                "invalidated",
                "rejected"
              ]
            }
          }
        }
      }
    },
    "remediation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governance": {
      "type": "object",
      "description": "Governance profile and the evidence behind P-SEC-001/P-AGT-001 (added in 2.3.0; P-AI-001 evidence is in ai). The citizen profile is a governance choice made by an operator or declared by the repository, never an inference about authorship.",
      "properties": {
        "profile": {
          "enum": [
            "standard",
            "citizen"
          ]
        },
        "custodians": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custodian_source": {
          "enum": [
            "operator-policy",
            "repository",
            "none"
          ]
        },
        "public_exposure_leads": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "agent_leads": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "repository_suppressed_leads": {
          "type": "integer",
          "description": "public-exposure or agent leads that repository scan config or inline pragmas would hide; the citizen profile does not honour them"
        },
        "agent": {
          "type": "object",
          "properties": {
            "configs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "servers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "brief": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the decision in plain language; shown first in citizen-profile views"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "SBOM, attestation and JFrog evidence. sbom_minimum_elements (added in 2.4.0) is the best SBOM's coverage of the NTIA 2021 minimum elements; none when no SBOM was found.",
      "properties": {
        "sbom_minimum_elements": {
          "enum": [
            "met",
            "partial",
            "not-met",
            "none"
          ]
        },
        "sbom_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "description": "AI-use inventory (added in 2.4.0): a static record of the AI model services the software can reach, the agent tooling it carries, and sensitive data reachable alongside an AI service. Not proof of what runs or of what data moves.",
      "properties": {
        "state": {
          "enum": [
            "assessed",
            "not assessed"
          ]
        },
        "observed": {
          "type": "boolean",
          "description": "any model service, agent tool server, agent instruction file, or agent lead"
        },
        "model_services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "engine": {
                "type": "string"
              },
              "evidence": {
                "enum": [
                  "verified",
                  "supported",
                  "inferred",
                  "unknown"
                ]
              },
              "reached_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "agent_tool_servers": {
          "type": "integer"
        },
        "instruction_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_oversight": {
          "type": "string"
        },
        "sensitive_data_with_ai": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "principal": {
                "type": "string"
              },
              "data": {
                "type": "string"
              },
              "sensitivity": {
                "enum": [
                  "confidential",
                  "restricted"
                ]
              },
              "ai_service": {
                "type": "string"
              }
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "alignment": {
      "type": "object",
      "description": "Orientation crosswalk (added in 2.4.0) from passport rules and evidence areas to NIST AI RMF 1.0 subcategories and IAPP AIGP domains. Orientation only: not a conformity assessment, a certification, or legal advice.",
      "properties": {
        "note": {
          "type": "string"
        },
        "frameworks": {
          "type": "object"
        },
        "rules": {
          "type": "object"
        },
        "evidence": {
          "type": "object"
        },
        "triggered": {
          "type": "object",
          "description": "the rules behind this decision, with their references"
        },
        "subcategories": {
          "type": "object",
          "description": "quoted NIST AI RMF subcategory statements cited by the triggered rules"
        }
      }
    }
  }
}
