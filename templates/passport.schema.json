{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloudbustinguk/jankhunt42/templates/passport.schema.json",
  "title": "jankhunt42 software passport (jankhunt.passport.v1)",
  "description": "Output of `jankhunt42 passport --json`: a local assessment, never an approval or certificate. lifecycle.state is draft, assessed, or accepted; accepted only with an operator acceptance record (outside the repository) bound to the same revision, policy hash, decision and, when given, artifact digest and environment. Acceptance is declared-by-operator, never verified.",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "source_revision",
    "scan_id",
    "generated_at",
    "scope",
    "coverage",
    "warnings",
    "evidence",
    "truncation",
    "subject",
    "assessment",
    "ownership",
    "provenance",
    "data",
    "operations",
    "lifecycle",
    "remediation",
    "unknowns",
    "limitations",
    "graph_ref"
  ],
  "properties": {
    "capability_delta": {
      "type": "object",
      "required": ["model", "state", "base_sha", "head_sha", "counts", "requests", "unknowns", "truncation", "context_hash", "delta_hash"],
      "properties": {
        "model": {"const": "jankhunt.capability-delta.v1"},
        "state": {"enum": ["not-requested", "complete", "incomplete"]},
        "base_sha": {"type": ["string", "null"]},
        "head_sha": {"type": ["string", "null"]},
        "context_hash": {"type": ["string", "null"]},
        "delta_hash": {"type": ["string", "null"]},
        "counts": {"type": "object"},
        "requests": {"type": "array"},
        "unchanged_unknowns": {
          "type": "array",
          "description": "unresolved at both commits; listed, but not a reason for review of this change"
        },
        "unknowns": {"type": "array"},
        "truncation": {"type": "object"}
      }
    },
    "schema_version": {
      "type": "string",
      "enum": [
        "jankhunt.passport.v1"
      ]
    },
    "tool": {
      "type": "string",
      "enum": [
        "jankhunt42"
      ]
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "name",
        "revision",
        "artifact_digests",
        "environment"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "root",
        "files_scanned",
        "loc",
        "redaction"
      ]
    },
    "coverage": {
      "type": "object",
      "required": [
        "evidence_areas",
        "evidence_areas_present",
        "evidence_areas_total",
        "map"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "area",
          "state",
          "path",
          "line",
          "detail"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "observed",
              "declared",
              "inferred"
            ]
          }
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "jank",
        "findings",
        "exposure",
        "decision"
      ],
      "properties": {
        "exposure": {
          "type": "object",
          "required": [
            "class"
          ],
          "properties": {
            "class": {
              "type": "string",
              "enum": [
                "Low",
                "Moderate",
                "High",
                "Critical",
                "Unknown"
              ]
            }
          }
        },
        "decision": {
          "type": "object",
          "required": [
            "result",
            "reasons",
            "rules",
            "mode",
            "policy",
            "note"
          ],
          "properties": {
            "result": {
              "type": "string",
              "enum": [
                "pass",
                "review",
                "insufficient-evidence",
                "block"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "rule",
                  "title",
                  "outcome",
                  "message",
                  "evidence_refs",
                  "hard_floor"
                ],
                "properties": {
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "pass",
                      "review",
                      "insufficient-evidence",
                      "block"
                    ]
                  }
                }
              }
            },
            "policy": {
              "type": "object",
              "required": [
                "hash",
                "effective",
                "sources"
              ]
            }
          }
        }
      }
    },
    "ownership": {
      "type": "object",
      "required": [
        "state",
        "owners",
        "declared_owners",
        "evidence_refs"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "observed",
            "declared",
            "unknown"
          ]
        }
      }
    },
    "operations": {
      "type": "object"
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "state",
        "acceptance"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "assessed",
            "accepted"
          ]
        },
        "acceptance": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not-supplied",
                "declared-by-operator",
                "invalidated",
                "rejected"
              ]
            }
          }
        }
      }
    },
    "remediation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "governance": {
      "type": "object",
      "description": "Governance profile and the evidence behind P-SEC-001/P-AGT-001 (added in 2.3.0; P-AI-001 evidence is in ai). The citizen profile is a governance choice made by an operator or declared by the repository, never an inference about authorship.",
      "properties": {
        "profile": {
          "enum": [
            "standard",
            "citizen"
          ]
        },
        "custodians": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custodian_source": {
          "enum": [
            "operator-policy",
            "repository",
            "none"
          ]
        },
        "public_exposure_leads": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "agent_leads": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "repository_suppressed_leads": {
          "type": "integer",
          "description": "public-exposure or agent leads that repository scan config or inline pragmas would hide; the citizen profile does not honour them"
        },
        "agent": {
          "type": "object",
          "properties": {
            "configs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "servers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "brief": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "the decision in plain language; shown first in citizen-profile views"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "SBOM, attestation and JFrog evidence. sbom_minimum_elements (added in 2.4.0) is the best SBOM's coverage of the NTIA 2021 minimum elements; none when no SBOM was found.",
      "properties": {
        "sbom_minimum_elements": {
          "enum": [
            "met",
            "partial",
            "not-met",
            "none"
          ]
        },
        "sbom_missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "description": "AI-use inventory (added in 2.4.0): a static record of the AI model services the software can reach, the agent tooling it carries, and sensitive data reachable alongside an AI service. Not proof of what runs or of what data moves.",
      "properties": {
        "state": {
          "enum": [
            "assessed",
            "not assessed"
          ]
        },
        "observed": {
          "type": "boolean",
          "description": "any model service, agent tool server, agent instruction file, or agent lead"
        },
        "model_services": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "engine": {
                "type": "string"
              },
              "evidence": {
                "enum": [
                  "verified",
                  "supported",
                  "inferred",
                  "unknown"
                ]
              },
              "reached_by": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "agent_tool_servers": {
          "type": "integer"
        },
        "instruction_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_oversight": {
          "enum": [
            "approval bypass observed",
            "no approval bypass observed",
            "no agent tooling observed"
          ]
        },
        "sensitive_data_with_ai": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "data": {
                "type": "string"
              },
              "sensitivity": {
                "enum": [
                  "confidential",
                  "restricted"
                ]
              },
              "ai_service": {
                "type": "string"
              },
              "reached_by": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "principals that reach both"
              }
            }
          },
          "description": "one entry per data store and AI service, at most 20; sensitive_data_with_ai_total counts all of them"
        },
        "note": {
          "type": "string"
        },
        "sensitive_data_with_ai_total": {
          "type": "integer"
        }
      }
    },
    "alignment": {
      "type": "object",
      "description": "Orientation crosswalk (added in 2.4.0) from passport rules and evidence areas to NIST AI RMF 1.0 subcategories and IAPP AIGP domains. Orientation only: not a conformity assessment, a certification, or legal advice.",
      "properties": {
        "note": {
          "type": "string"
        },
        "frameworks": {
          "type": "object"
        },
        "rules": {
          "type": "object"
        },
        "evidence": {
          "type": "object"
        },
        "triggered": {
          "type": "object",
          "description": "the rules behind this decision, with their references"
        },
        "subcategories": {
          "type": "object",
          "description": "quoted NIST AI RMF subcategory statements cited by the triggered rules"
        }
      }
    },
    "egress": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "declared",
            "unknown"
          ]
        },
        "outside": {
          "type": [
            "array",
            "integer"
          ],
          "items": {
            "type": "object",
            "properties": {
              "contexts": {
                "type": "array",
                "items": {"type": "string"},
                "description": "the tools (and Codex profiles) whose selected declaration does not admit this host"
              }
            }
          }
        },
        "unused": {
          "type": [
            "array",
            "integer"
          ]
        },
        "wildcards": {
          "type": [
            "array",
            "integer"
          ]
        },
        "contexts": {
          "type": ["array", "integer"],
          "items": {
            "type": "object",
            "required": ["tool", "path", "state"],
            "properties": {
              "state": {"enum": ["declared", "unknown"]},
              "profile": {"type": ["string", "null"]},
              "selected": {"type": ["boolean", "null"]},
              "enabled": {"type": ["boolean", "null"]},
              "outside": {"type": "array"},
              "unused": {"type": "array"},
              "wildcards": {"type": "array"},
              "unassessed": {"type": "array"}
            }
          }
        },
        "unassessed": {
          "type": ["array", "integer"]
        },
        "boundaries": {
          "type": [
            "array",
            "integer"
          ],
          "items": {
            "type": "object",
            "properties": {
              "profile": {"type": ["string", "null"]},
              "selected": {"type": ["boolean", "null"]},
              "enabled": {"type": ["boolean", "null"]}
            }
          }
        }
      }
    },
    "change_control": {
      "type": "object",
      "required": [
        "state",
        "checks"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "provider-verified",
            "declared",
            "unknown"
          ]
        },
        "checks": {
          "type": "object",
          "properties": {
            "pull_request_review": {
              "type": "object",
              "required": [
                "state",
                "detail"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "unknown"
                  ]
                }
              }
            },
            "code_owner_review": {
              "type": "object",
              "required": [
                "state",
                "detail"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "unknown"
                  ]
                }
              }
            },
            "last_push_approval": {
              "type": "object",
              "required": [
                "state",
                "detail"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "unknown"
                  ]
                }
              }
            },
            "status_checks": {
              "type": "object",
              "required": [
                "state",
                "detail"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "unknown"
                  ]
                }
              }
            },
            "deletion_protected": {
              "type": "object",
              "required": [
                "state",
                "detail"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "unknown"
                  ]
                }
              }
            },
            "force_push_protected": {
              "type": "object",
              "required": [
                "state",
                "detail"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "unknown"
                  ]
                }
              }
            },
            "no_app_bypass": {
              "type": "object",
              "required": [
                "state",
                "detail"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "unknown"
                  ]
                }
              }
            },
            "codeowners_coverage": {
              "type": "object",
              "required": [
                "state",
                "detail"
              ],
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "met",
                    "not-met",
                    "unknown"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "package_sources": {
      "type": "object",
      "required": [
        "ecosystems"
      ],
      "properties": {
        "ecosystems": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "state",
              "sources"
            ],
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "observed",
                  "declared",
                  "unknown"
                ]
              }
            }
          }
        },
        "assessment": {
          "type": "object",
          "properties": {
            "disallowed": {
              "type": "array"
            },
            "unconfigured": {
              "type": "array"
            },
            "allowed_registries": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}
