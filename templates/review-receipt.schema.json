{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jankhunt42.invalid/schemas/review-receipt-1.0.json",
  "title": "JankHunt42 review receipt",
  "description": "A static-evidence review finding. A receipt is not a runtime confirmation.",
  "type": "object",
  "required": [
    "id",
    "rule",
    "title",
    "severity",
    "category",
    "confidence",
    "path",
    "line",
    "scope",
    "verification",
    "evidence",
    "message",
    "counterevidence",
    "repro",
    "scan_id",
    "receipt_version",
    "receipt_hash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^JH-[0-9a-f]{12}$"
    },
    "rule": {"type": "string", "pattern": "^JH[0-9]{3}$"},
    "title": {"type": "string"},
    "severity": {
      "type": "string",
      "enum": ["blocker", "critical", "major", "minor", "info"]
    },
    "category": {"type": "string"},
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "path": {"type": "string"},
    "line": {"type": "integer", "minimum": 1},
    "column": {"type": "integer", "minimum": 1},
    "end_line": {"type": ["integer", "null"], "minimum": 1},
    "location": {
      "type": "object",
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "scope": {
      "type": "string",
      "enum": ["new", "contextual", "persisting"]
    },
    "verification": {
      "type": "string",
      "enum": ["supported", "unverified"],
      "description": "supported = static evidence from a high/medium-confidence rule; unverified = a lead that needs adjudication. Runtime confirmation is not emitted by the review command."
    },
    "evidence": {"type": "string"},
    "message": {"type": "string"},
    "fix": {"type": "string"},
    "counterevidence": {"type": "string"},
    "repro": {"type": "string"},
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "scan_id": {"type": "string"},
    "receipt_version": {"type": "string"},
    "receipt_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
